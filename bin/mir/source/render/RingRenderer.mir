import Toybox.Math;
//! Perimeter ring "Body 24 h": the last 23 hours of Body Battery on a 24-hour dial.
//! Noon is at the top and midnight at the bottom, like the sun in the sky.
//! Brightness of the cyan = energy level, so the night charge shows as a ring
//! segment getting brighter. Marks: a white tick at "now", amber ticks at sunrise
//! and sunset. The hour after "now" stays empty to separate today from yesterday.
//! Colours are precomputed per bucket; one frame draws only merged arcs.
[ @file = "/Users/dageev/Documents/GARMIN/watch/source/render/RingRenderer.mc"; @line = 11; @symbol_moduledef = [RingRenderer,11,7,19]; ]
